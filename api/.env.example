NODE_ENV=development
PORT=5011

DATABASE_URL=postgres://poll:securethepoll@localhost:5432/securepoll

# Signs admin session tokens. Minimum 32 characters, and must be a distinct random value
# per environment: whoever holds this can mint an admin session, and an admin session can
# enfranchise voters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_TTL_SECONDS=7200

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

BCRYPT_ROUNDS=12

# Outbound mail via nodemailer / SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Secure Poll <noreply@example.com>
